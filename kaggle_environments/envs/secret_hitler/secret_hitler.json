{
  "name": "secret_hitler",
  "title": "Secret Hitler",
  "description": "A hidden-role social deduction game of policy enactment, deception, and deduction for 5-10 players.",
  "version": "1.0.0",
  "agents": [5, 6, 7, 8, 9, 10],
  "configuration": {
    "episodeSteps": {
      "description": "Maximum number of steps in the episode.",
      "type": "integer",
      "default": 2000,
      "minimum": 1
    },
    "actTimeout": {
      "description": "Seconds an agent has to act each turn.",
      "type": "number",
      "default": 30,
      "minimum": 1
    },
    "runTimeout": {
      "description": "Maximum runtime of the episode in seconds.",
      "type": "number",
      "default": 1800
    },
    "seed": {
      "description": "Random seed for deterministic role/id/deck shuffling.",
      "type": "integer",
      "default": 123
    },
    "randomize_roles": {
      "description": "Whether to shuffle the configured roles among players.",
      "type": "boolean",
      "default": false
    },
    "randomize_ids": {
      "description": "Whether to shuffle the configured player ids.",
      "type": "boolean",
      "default": false
    },
    "agents": {
      "description": "Per-player configuration. Provide exactly one entry per player; role counts must match the player count.",
      "type": "array",
      "default": [
        {"id": "player_1", "role": "Liberal", "agent_id": "random"},
        {"id": "player_2", "role": "Liberal", "agent_id": "random"},
        {"id": "player_3", "role": "Liberal", "agent_id": "random"},
        {"id": "player_4", "role": "Liberal", "agent_id": "random"},
        {"id": "player_5", "role": "Liberal", "agent_id": "random"},
        {"id": "player_6", "role": "Liberal", "agent_id": "random"},
        {"id": "player_7", "role": "Fascist", "agent_id": "random"},
        {"id": "player_8", "role": "Fascist", "agent_id": "random"},
        {"id": "player_9", "role": "Fascist", "agent_id": "random"},
        {"id": "player_10", "role": "Hitler", "agent_id": "random"}
      ],
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "description": "Unique player name."},
          "role": {"type": "string", "enum": ["Liberal", "Fascist", "Hitler"]},
          "agent_id": {"type": "string"},
          "role_params": {"type": "object", "default": {}},
          "display_name": {"type": "string", "default": ""},
          "thumbnail": {"type": "string", "default": ""},
          "agent_harness_name": {"type": "string", "default": ""},
          "llms": {"type": "array", "default": []}
        },
        "required": ["id", "role"]
      }
    },
    "discussion_protocol": {
      "description": "Discussion protocol configuration ({name, params}).",
      "type": "object",
      "default": {"name": "TurnByTurnBiddingDiscussion", "params": {"max_turns": 3, "max_bid": 3}}
    }
  },
  "observation": {
    "remainingOverageTime": {
      "description": "Pooled overage time in seconds.",
      "type": "number",
      "shared": false,
      "default": 60
    }
  },
  "action": {
    "type": "object",
    "additionalProperties": true
  },
  "reward": {
    "description": "+1 for winners, -1 for losers, 0 for a no-winner timeout.",
    "type": "number",
    "minimum": -1,
    "maximum": 1,
    "default": 0
  }
}
