# Template for local LLM provider API keys.
#
# Usage:
#   cp .env.example .env
#   # then paste your real keys into .env (it is gitignored and never committed)
#
# Only fill in the providers you actually use. litellm reads these from the
# environment; the model string you pass (e.g. "openai/gpt-4o-mini",
# "anthropic/claude-sonnet-4-6", "gemini/gemini-2.5-flash") selects the provider.

# --- OpenAI (GPT) ---
OPENAI_API_KEY=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Google (Gemini) ---
GEMINI_API_KEY=

# --- OpenRouter (gateway to many models) ---
OPENROUTER_API_KEY=

# --- xAI (Grok) ---
XAI_API_KEY=

# --- Mistral ---
MISTRAL_API_KEY=

# --- Groq ---
GROQ_API_KEY=

# --- DeepSeek ---
DEEPSEEK_API_KEY=

# Optional: default model for the Secret Hitler local runner
# (overridden by --model on the command line)
SECRET_HITLER_LLM_MODEL=openai/gpt-4o-mini
